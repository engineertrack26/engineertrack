EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Crash reporting: the project's public DSN (Settings › Projects › react-native › Client Keys).
# Leave empty to disable Sentry. Source-map upload on EAS needs SENTRY_AUTH_TOKEN as a secret env var.
EXPO_PUBLIC_SENTRY_DSN=

# See .env — required: expo/fetch (SDK 56 default) cannot upload a React Native
# file part, which breaks every avatar and evidence upload.
EXPO_PUBLIC_USE_RN_FETCH=1
