{
  "expo": {
    "name": "EngineerTrack",
    "slug": "engineertrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/engineertrack-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.engineertrack.app",
      "infoPlist": {
        "NSCameraUsageDescription": "EngineerTrack needs camera access to take photos for daily logs.",
        "NSPhotoLibraryUsageDescription": "EngineerTrack needs photo library access to attach images to daily logs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF0EC"
      },
      "package": "com.engineertrack.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "engineertrack",
    "plugins": [
      "expo-image-picker",
      "expo-notifications",
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      "expo-router",
      "@sentry/react-native",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EEF0EC"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "572a3922-f6f2-4d4c-90af-21df8d0645f3"
      }
    },
    "owner": "engineer-track"
  }
}
